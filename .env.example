VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=tu-clave-publicable-local

# Activar únicamente con Google habilitado en Supabase.
VITE_AUTH_GOOGLE_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Opcional: sin clave se conserva OpenStreetMap. Restringir por sitios web y APIs.
VITE_GOOGLE_MAPS_API_KEY=
# Para producción usar un Map ID propio; en local se utiliza DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
VITE_GOOGLE_MAPS_ENABLED=false
